{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Haven",
  "version": "3.0.0",
  "identifier": "com.haven.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:14370",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "welcome",
        "title": "Haven",
        "width": 720,
        "height": 560,
        "minWidth": 620,
        "minHeight": 480,
        "resizable": false,
        "decorations": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#0d0d1a",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --ignore-certificate-errors"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["deb", "appimage", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Haven Desktop — private self-hosted chat",
    "longDescription": "Native desktop client for Haven private chat. Connect to any Haven server with system tray, notifications, and per-app audio capture.",
    "linux": {
      "deb": {
        "depends": ["libgtk-4-1 (>= 4.14)", "libgraphene-1.0-0", "libnss3", "libasound2 | libasound2t64", "libgbm1", "libxkbcommon0", "libxcomposite1", "libxdamage1", "libxrandr2", "libcups2 | libcups2t64", "libatk-bridge2.0-0 | libatk-bridge2.0-0t64", "libpulse0", "zenity | kdialog"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "startMenuFolder": "Haven"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2MjQ4QjA5RjgwOURCNzYKUldSMjJ3bjRDWXNrVmswaGV2bFU0eHM0eWZMVmRrcExMRFJ4aEpvT05VMDQ2REpLbndEZUJCVTMK",
      "endpoints": ["https://github.com/Amnibro/Haven-Desktop/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
