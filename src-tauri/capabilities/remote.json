{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote",
  "description": "Remote Haven server pages: only the commands the havenDesktop bridge needs",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://*",
      "https://*",
      "http://*:*",
      "https://*:*"
    ]
  },
  "permissions": [
    "core:event:default",
    "haven-remote"
  ]
}