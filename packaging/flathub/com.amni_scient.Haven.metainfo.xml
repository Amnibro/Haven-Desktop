<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.amni_scient.Haven</id>
  <name>Haven</name>
  <summary>Private self-hosted chat</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-only</project_license>
  <developer id="com.amni_scient">
    <name>Amni-Scient</name>
  </developer>
  <description>
    <p>
      Desktop client for Haven, a private chat server you host yourself.
      Connect to any Haven server for text channels, voice and video calls,
      and screen sharing, with a tray icon that shows when something is unread
      and desktop notifications.
    </p>
    <p>
      Haven Desktop needs a Haven server to join: your own, or one a friend or
      community runs.
    </p>
  </description>
  <launchable type="desktop-id">com.amni_scient.Haven.desktop</launchable>
  <screenshots>
    <screenshot type="default">
      <caption>Joining a Haven server</caption>
      <image>https://raw.githubusercontent.com/Amnibro/Haven-Desktop/main/packaging/flathub/screenshots/welcome.png</image>
    </screenshot>
  </screenshots>
  <url type="homepage">https://amni-scient.com/amni-haven</url>
  <url type="vcs-browser">https://github.com/Amnibro/Haven-Desktop</url>
  <url type="bugtracker">https://github.com/Amnibro/Haven-Desktop/issues</url>
  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-audio">intense</content_attribute>
    <content_attribute id="social-contacts">intense</content_attribute>
  </content_rating>
  <branding>
    <color type="primary" scheme_preference="light">#b9a8f7</color>
    <color type="primary" scheme_preference="dark">#4b36a9</color>
  </branding>
  <provides>
    <binary>haven-desktop</binary>
  </provides>
  <releases>
    <release version="2.7.3" date="2026-11-24">
      <description>
        <p>Builds for 64-bit ARM computers, an option to show what you are playing or listening to from your other apps, and opening Haven a second time brings back the window that is already open.</p>
      </description>
    </release>
    <release version="2.7.2" date="2026-11-19"/>
    <release version="2.7.1" date="2026-11-09"/>
    <release version="2.7.0" date="2026-11-03"/>
  </releases>
</component>
