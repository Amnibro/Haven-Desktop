// ═══════════════════════════════════════════════════════════
// Haven Desktop — Server Manager
//
// Detects, starts, and manages a local Haven server process.
// ═══════════════════════════════════════════════════════════

const { spawn } = require('child_process');
const path = require('path');
const fs   = require('fs');
const net  = require('net');
const http = require('http');
const https = require('https');

class ServerManager {
  constructor(store, opts = {}) {
    this.store         = store;
    this.serverProcess = null;
    this._running      = false;
    this._port         = null;
    this._url          = null;
    this._showConsole  = opts.showConsole || false;
    this._owned        = false;
  }

  detectServer() {
    const candidates = [];
    const saved = this.store.get('userPrefs.serverPath');
    if (saved) candidates.push(saved);

    const parent = path.resolve(__dirname, '..', '..', '..');
    candidates.push(path.join(parent, 'Haven-Braid'));
    candidates.push(path.join(parent, 'haven-braid'));
    candidates.push(path.join(parent, 'Haven'));
    candidates.push(path.join(parent, 'haven'));

    const home = process.env.HOME || process.env.USERPROFILE || '';
    if (home) {
      candidates.push(path.join(home, 'Haven-Braid'));
      candidates.push(path.join(home, 'Haven'));
      candidates.push(path.join(home, 'Desktop', 'Haven-Braid'));
      candidates.push(path.join(home, 'Desktop', 'Haven'));
      candidates.push(path.join(home, 'Documents', 'Haven-Braid'));
      candidates.push(path.join(home, 'Documents', 'ai', 'Haven-Braid'));
      candidates.push(path.join(home, 'Documents', 'Haven'));
      candidates.push(path.join(home, 'Documents', 'ai', 'Haven'));
      const appData = process.env.APPDATA || path.join(home, 'AppData', 'Roaming');
      candidates.push(path.join(appData, 'HavenServer'));
      candidates.push(path.join(appData, 'Haven'));
      candidates.push(path.join(appData, 'haven'));
      const localAppData = process.env.LOCALAPPDATA || path.join(home, 'AppData', 'Local');
      candidates.push(path.join(localAppData, 'Programs', 'Haven'));
      candidates.push(path.join(localAppData, 'Programs', 'haven'));
      candidates.push(path.join(localAppData, 'Programs', 'haven-server'));
      candidates.push(path.join(localAppData, 'Programs', 'HavenServer'));
      candidates.push(path.join(home, 'AppData', 'Local', 'Haven'));
    }

    let fallback = null;
    for (const dir of candidates) {
      try {
        const sjs = path.join(dir, 'server.js');
        const pkg = path.join(dir, 'package.json');
        if (!fs.existsSync(sjs) || !fs.existsSync(pkg)) continue;
        const raw = fs.readFileSync(pkg, 'utf-8').replace(/^\uFEFF/, '');
        const json = JSON.parse(raw);
        if (json.name !== 'haven') continue;
        const hasDeps = fs.existsSync(path.join(dir, 'node_modules', 'better-sqlite3'));
        const hit = { found: true, path: dir, version: json.version };
        if (hasDeps) return hit;
        if (!fallback) fallback = hit;
      } catch { /* continue */ }
    }
    return fallback || { found: false, path: null };
  }

  _persistSuccess(serverDir, port, url) {
    this._running = true;
    this._port = port;
    this._url = url;
    try {
      this.store.set('userPrefs.serverPath', serverDir);
      this.store.set('userPrefs.serverUrl', url);
      this.store.set('userPrefs.mode', 'host');
      const hist = this.store.get('serverHistory') || [];
      const cleaned = hist
        .filter(e => e && e.url)
        .map(e => {
          try {
            const u = new URL(e.url);
            if ((u.hostname === 'localhost' || u.hostname === '127.0.0.1') && u.protocol === 'https:') {
              u.protocol = 'http:';
              return { ...e, url: u.origin };
            }
          } catch {}
          return e;
        })
        .filter(e => e.url !== url && e.url !== `https://localhost:${port}` && e.url !== `http://localhost:${port}`);
      this.store.set('serverHistory', [{ url, name: 'Local Haven', lastConnected: Date.now() }, ...cleaned].slice(0, 20));
    } catch {}
  }

  async startServer(serverDir) {
    if (this._running && this._url) {
      return { success: true, port: this._port, url: this._url };
    }

    const sjs = path.join(serverDir, 'server.js');
    if (!fs.existsSync(sjs)) {
      return { success: false, error: 'server.js not found in the chosen directory.' };
    }
    if (!fs.existsSync(path.join(serverDir, 'node_modules', 'better-sqlite3'))) {
      return {
        success: false,
        error: `Dependencies missing in ${serverDir}. Run npm install there first.`,
      };
    }

    const preferred = parseInt(process.env.HAVEN_DESKTOP_PORT || process.env.PORT || '3000', 10) || 3000;

    // Always prefer an already-healthy Haven on the preferred port (stock Start Haven.bat).
    const existing = await this._probeHealth(preferred);
    if (existing) {
      this._owned = false;
      this._persistSuccess(serverDir, preferred, existing.url);
      this._emitLog(`[Haven Desktop] Reusing live server at ${existing.url}\n`);
      return { success: true, port: preferred, url: existing.url, reused: true };
    }

    // Port taken by non-Haven? Pick next free. Free? Use preferred after clear.
    let port = preferred;
    if (!(await this._portFree(preferred))) {
      port = await this._findPort(preferred + 1);
      this._emitLog(`[Haven Desktop] Port ${preferred} busy (not Haven) — using ${port}\n`);
    } else {
      await this._killProcessOnPort(preferred);
    }

    return this._spawnServer(serverDir, port);
  }

  _spawnServer(serverDir, port) {
    return new Promise(resolve => {
      const forceHttp = String(process.env.FORCE_HTTP || 'true').toLowerCase() !== 'false';
      const env = {
        ...process.env,
        PORT: String(port),
        FORCE_HTTP: forceHttp ? 'true' : (process.env.FORCE_HTTP || 'true'),
      };
      const nodeCmd = process.platform === 'win32' ? 'node.exe' : 'node';
      const nodeArgs = ['--max-old-space-size=512', '--expose-gc', path.join(serverDir, 'server.js')];
      const spawnOpts = {
        cwd: serverDir,
        env,
        shell: false,
        stdio: ['pipe', 'pipe', 'pipe'],
        windowsHide: !this._showConsole,
      };
      if (this._showConsole) {
        spawnOpts.detached = true;
        spawnOpts.windowsHide = false;
      }

      this.serverProcess = spawn(nodeCmd, nodeArgs, spawnOpts);
      this._owned = true;
      this._port = port;

      let resolved = false;
      let isHTTPS = false;
      let sawEaddr = false;

      const finish = (ok, extra = {}) => {
        if (resolved) return;
        resolved = true;
        if (ok) {
          const protocol = (!forceHttp && isHTTPS) ? 'https' : 'http';
          const url = `${protocol}://localhost:${this._port}`;
          this._persistSuccess(serverDir, this._port, url);
          resolve({ success: true, port: this._port, url, ...extra });
        } else {
          this._running = false;
          resolve({ success: false, port: this._port, ...extra });
        }
      };

      this.serverProcess.stdout.on('data', (d) => {
        const msg = d.toString();
        this._emitLog(msg);
        if (!forceHttp && /https enabled/i.test(msg)) isHTTPS = true;
        if (!resolved && /HAVEN is running|listening|running on port|Local:\s+https?:\/\//i.test(msg)) {
          finish(true);
        }
      });

      this.serverProcess.stderr.on('data', (d) => {
        const msg = d.toString();
        this._emitLog('[ERR] ' + msg);
        if (/EADDRINUSE/i.test(msg)) sawEaddr = true;
      });

      this.serverProcess.on('error', (err) => finish(false, { error: err.message }));

      this.serverProcess.on('exit', (code, signal) => {
        const intentional = this._intentionalStop;
        this._intentionalStop = false;
        if (!resolved) {
          if (sawEaddr) {
            finish(false, { error: `Port ${this._port} already in use. Stop the other process or Host again.` });
          } else {
            finish(false, { error: `Server exited early (code ${code}, signal ${signal || 'none'}).` });
          }
          return;
        }
        this._running = false;
        if (intentional || !this._owned) return;
        if (code !== 0 && code !== null) {
          const now = Date.now();
          if (now - (this._lastRestart || 0) < 5000) {
            this._emitLog('[Haven Desktop] Server crashed repeatedly — not restarting.\n');
            return;
          }
          this._lastRestart = now;
          this._emitLog(`[Haven Desktop] Server exited with code ${code} — restarting in 2 s…\n`);
          setTimeout(() => {
            if (!this._intentionalStop) this.startServer(serverDir).catch(() => {});
          }, 2000);
        }
      });

      // Poll health instead of blind 15s success
      let tries = 0;
      const poll = setInterval(async () => {
        if (resolved) { clearInterval(poll); return; }
        tries++;
        const health = await this._probeHealth(this._port);
        if (health) {
          clearInterval(poll);
          isHTTPS = health.url.startsWith('https');
          finish(true);
          return;
        }
        if (tries >= 30) {
          clearInterval(poll);
          finish(false, { error: 'Server did not become healthy within 30s. Check Node / npm install in the server folder.' });
        }
      }, 1000);
    });
  }

  stopServer() {
    this._intentionalStop = true;
    if (this.serverProcess && this._owned) {
      const pid = this.serverProcess.pid;
      try {
        if (process.platform === 'win32' && pid) {
          const { execSync } = require('child_process');
          try { execSync(`taskkill /F /T /PID ${pid}`, { stdio: 'ignore' }); } catch {}
        } else {
          this.serverProcess.kill('SIGTERM');
        }
      } catch {}
      this.serverProcess = null;
    }
    this._running = false;
    this._port = null;
    this._url = null;
    this._owned = false;
    return { success: true };
  }

  getStatus() {
    return {
      running: this._running,
      port: this._port,
      url: this._running ? (this._url || `http://localhost:${this._port}`) : null,
    };
  }

  isRunning() { return this._running; }

  onLog(cb) { this._logCb = cb; }
  _emitLog(msg) { if (this._logCb) this._logCb(msg); }

  _portFree(p) {
    return new Promise(r => {
      const s = net.createServer();
      s.unref();
      s.on('error', () => r(false));
      s.listen({ port: p, host: '0.0.0.0', exclusive: true }, () => {
        s.close(() => r(true));
      });
    });
  }

  async _findPort(start) {
    for (let p = start; p < start + 100; p++) {
      if (await this._portFree(p)) return p;
    }
    throw new Error('No available port found');
  }

  _probeOnce(mod, port, rejectUnauthorized) {
    return new Promise(resolve => {
      const req = mod.get({
        host: '127.0.0.1',
        port,
        path: '/api/health',
        timeout: 1200,
        rejectUnauthorized: !!rejectUnauthorized,
      }, res => {
        let body = '';
        res.on('data', c => { body += c; });
        res.on('end', () => {
          try {
            const j = JSON.parse(body);
            if (j && (j.status === 'online' || j.name)) {
              const proto = mod === https ? 'https' : 'http';
              resolve({ url: `${proto}://localhost:${port}`, name: j.name || 'Haven' });
              return;
            }
          } catch {}
          resolve(null);
        });
      });
      req.on('error', () => resolve(null));
      req.on('timeout', () => { try { req.destroy(); } catch {} resolve(null); });
    });
  }

  async _probeHealth(port) {
    const httpHit = await this._probeOnce(http, port, true);
    if (httpHit) return httpHit;
    return this._probeOnce(https, port, false);
  }

  async _killProcessOnPort(port) {
    return new Promise(resolve => {
      const { exec } = require('child_process');
      if (process.platform === 'win32') {
        exec(`netstat -ano | findstr "LISTENING" | findstr ":${port} "`, (err, stdout) => {
          if (err || !stdout) return resolve();
          const pids = new Set();
          for (const line of stdout.trim().split('\n')) {
            const parts = line.trim().split(/\s+/);
            const pid = parseInt(parts[parts.length - 1], 10);
            if (pid && pid !== process.pid) pids.add(pid);
          }
          if (pids.size === 0) return resolve();
          let killed = 0;
          for (const pid of pids) {
            exec(`taskkill /F /PID ${pid}`, (e) => {
              if (!e) console.log(`[Haven Desktop] Killed zombie process PID ${pid} on port ${port}`);
              killed++;
              if (killed === pids.size) setTimeout(resolve, 500);
            });
          }
        });
      } else {
        exec(`lsof -ti:${port}`, (err, stdout) => {
          if (err || !stdout) return resolve();
          const pids = stdout.trim().split('\n').map(p => parseInt(p, 10)).filter(p => p && p !== process.pid);
          if (pids.length === 0) return resolve();
          exec(`kill -9 ${pids.join(' ')}`, () => setTimeout(resolve, 500));
        });
      }
    });
  }
}

module.exports = { ServerManager };
