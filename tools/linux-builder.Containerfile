FROM --platform=linux/amd64 docker.io/library/ubuntu:22.04
ARG DEB_ARCH=amd64
ENV DEBIAN_FRONTEND=noninteractive PATH=/root/.cargo/bin:$PATH APPIMAGE_EXTRACT_AND_RUN=1 NO_STRIP=true CXX=g++ PKG_CONFIG_ALLOW_CROSS=1 CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc CXX_aarch64_unknown_linux_gnu=aarch64-linux-gnu-g++ PKG_CONFIG_LIBDIR_aarch64_unknown_linux_gnu=/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig
RUN L="libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev librsvg2-dev libssl-dev libpulse-dev libxdo-dev" X= T= && if [ $DEB_ARCH != amd64 ]; then sed -i 's/^deb /deb [arch=amd64] /' /etc/apt/sources.list && dpkg --add-architecture $DEB_ARCH && printf 'deb [arch=arm64] http://ports.ubuntu.com/ubuntu-ports jammy main universe\ndeb [arch=arm64] http://ports.ubuntu.com/ubuntu-ports jammy-updates main universe\ndeb [arch=arm64] http://ports.ubuntu.com/ubuntu-ports jammy-security main universe\n' > /etc/apt/sources.list.d/ports.list && X="gcc-aarch64-linux-gnu g++-aarch64-linux-gnu" T="-t aarch64-unknown-linux-gnu" L=$(printf '%s:arm64 ' $L); fi && apt-get update && apt-get install -y build-essential pkg-config curl wget file patchelf ca-certificates git xdg-utils $X $L && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && apt-get install -y nodejs && curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal $T && rm -rf /var/lib/apt/lists/*
ENV PKG_CONFIG_PATH=/usr/lib/aarch64-linux-gnu/pkgconfig
RUN mv /usr/bin/ldd /usr/bin/ldd.real && printf '#!/bin/sh\nfor f; do :; done\ncase "$(file -b "$f" 2>/dev/null)" in *aarch64*) exec /lib/ld-linux-aarch64.so.1 --list "$@";; esac\nexec /usr/bin/ldd.real "$@"\n' > /usr/bin/ldd && chmod +x /usr/bin/ldd
WORKDIR /src
