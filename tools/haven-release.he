use os
say(msg const byte[:]):
	print("haven-release: ", msg);
json_text(s const byte[:]) byte[>..]:
	out byte[>..] ~= []
	hex := "0123456789abcdef"
	out.push('"')
	for c s:
		if c == '"':
			out.append("\\\"")
		else if c == '\\':
			out.append("\\\\")
		else if c == '\n':
			out.append("\\n")
		else if c == '\r':
			out.append("\\r")
		else if c == '\t':
			out.append("\\t")
		else if c < 32:
			out.append("\\u00")
			out.push(hex[c >> 4])
			out.push(hex[c & 15])
		else:
			out.push(c)
	out.push('"')
	out
feed_target(i int) const byte[:]:
	match i:
		0 => "windows-x86_64"
		1 => "linux-x86_64"
		2 => "linux-x86_64-deb"
		3 => "darwin-aarch64"
		_ => "darwin-x86_64"
feed_name(i int, version const byte[:]) byte[>..]:
	match i:
		0 => str("Haven_", version, "_x64-setup.exe")
		1 => str("Haven_", version, "_amd64.AppImage")
		2 => str("Haven_", version, "_amd64.deb")
		_ => str("Haven.app.tar.gz")
two_digits(out byte[>..]&, v int):
	if v < 10: out.push('0')
	format(out, v);
feed_now() byte[>..]:
	secs := time() as int
	days := secs / 86400
	rem := secs % 86400
	z := days + 719468
	era := z / 146097
	doe := z - era * 146097
	yoe := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
	y ~= yoe + era * 400
	doy := doe - (365 * yoe + yoe / 4 - yoe / 100)
	mp := (5 * doy + 2) / 153
	d := doy - (153 * mp + 2) / 5 + 1
	m := if mp < 10 { mp + 3 } else { mp - 9 }
	if m <= 2: y += 1
	out byte[>..] ~= []
	format(out, y)
	out.push('-')
	two_digits(out, m)
	out.push('-')
	two_digits(out, d)
	out.push('T')
	two_digits(out, rem / 3600)
	out.push(':')
	two_digits(out, rem % 3600 / 60)
	out.push(':')
	two_digits(out, rem % 60)
	out.append(".000Z")
	out
feed(dir const byte[:], version const byte[:], notes_path const byte[:]) int:
	for i 5:
		name := feed_name(i, version)
		path := str(dir, "/", name)
		buf byte[>..] ~= []
		if !read_file(path, buf):
			say(str("missing ", name))
			return 1
		sbuf byte[>..] ~= []
		if !read_file(str(path, ".sig"), sbuf) || trim(sbuf).len == 0:
			say(str("missing signature for ", name))
			return 1
	nbuf byte[>..] ~= []
	if !read_file(notes_path, nbuf) || trim(nbuf).len == 0:
		say("missing notes")
		return 1
	out byte[>..] ~= []
	out.append("{\n  \"version\": ")
	out.append(json_text(version))
	out.append(",\n  \"notes\": ")
	out.append(json_text(trim(nbuf)))
	out.append(",\n  \"pub_date\": ")
	out.append(json_text(feed_now()))
	out.append(",\n  \"platforms\": {\n")
	for i 5:
		name := feed_name(i, version)
		sg byte[>..] ~= []
		read_file(str(dir, "/", name, ".sig"), sg)
		out.append("    ")
		out.append(json_text(feed_target(i)))
		out.append(": {\n      \"signature\": ")
		out.append(json_text(trim(sg)))
		out.append(",\n      \"url\": ")
		out.append(json_text(str("https://github.com/Amnibro/Haven-Desktop/releases/download/v", version, "-tauri/", name)))
		out.append("\n    }")
		if i < 4: out.push(',')
		out.push('\n')
	out.append("  }\n}\n")
	target := str(dir, "/latest.json")
	write_file_atomic(target, out)
	say(str("wrote ", target))
	return 0
run_step(cmd const byte[:]) bool:
	if run_command(cmd) != 0:
		say(str("failed: ", cmd))
		return false
	true
amnios(checkout const byte[:], deb const byte[:], version const byte[:]) int:
	pdir := str(checkout, "/packaging/haven-desktop")
	pkg := str(pdir, "/PKGBUILD")
	shaf := str(pdir, "/.deb.sha256")
	if !run_step(str("sha256sum '", deb, "' > '", shaf, "'")): return 1
	sb byte[>..] ~= []
	read_file(shaf, sb)
	delete_file(shaf)
	ws := words(sb)
	sha byte[>..] ~= []
	if ws.len > 0: sha.append(ws[0])
	fb byte[>..] ~= []
	if !read_file(pkg, fb):
		say("PKGBUILD is missing a field")
		return 1
	parts := split(fb, '\n')
	out byte[>..] ~= []
	has_ver ~= false
	has_rel ~= false
	has_sum ~= false
	for line, i parts:
		if starts_with(line, "pkgver="):
			has_ver = true
			out.append("pkgver=")
			out.append(version)
		else if starts_with(line, "pkgrel="):
			has_rel = true
			out.append("pkgrel=1")
		else if starts_with(line, "sha256sums="):
			has_sum = true
			out.append("sha256sums=('")
			out.append(sha)
			out.append("')")
		else:
			out.append(line)
		if i < parts.len - 1: out.push('\n')
	if !has_ver || !has_rel || !has_sum:
		say("PKGBUILD is missing a field")
		return 1
	write_file_atomic(pkg, out)
	repo := str(checkout, "/out/haven-desktop-repo")
	debcopy := str(pdir, "/Haven_", version, "_amd64.deb")
	if !run_step(str("cp '", deb, "' '", debcopy, "'")): return 1
	if !run_step(str("rm -rf '", repo, "' && mkdir -p '", repo, "'")): return 1
	if !run_step(str("cd '", pdir, "' && PKGEXT=.pkg.tar PKGDEST='", repo, "' makepkg -f --nodeps --noconfirm")): return 1
	if !run_step(str("AMNI_LOCAL_REPO='", repo, "' bash '", checkout, "/tools/publish-repo.sh'")): return 1
	if !run_step(str("rm -rf '", pdir, "/src' '", pdir, "/pkg' '", debcopy, "' '", repo, "'")): return 1
	say(str("published haven-desktop ", version, "-1 to the Amni OS repo"))
	return 0
main():
	a := args()
	if a.len == 5 && a[1] == "feed": exit(feed(a[2], a[3], a[4]))
	if a.len == 5 && a[1] == "amnios": exit(amnios(a[2], a[3], a[4]))
	say("usage: haven-release feed <dir> <version> <notes file> | amnios <amni-os checkout> <deb file> <version>")
	exit(2);
